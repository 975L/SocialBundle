{# {{ share_buttons(networks, shape, fill, alignment, displayIcon, displayText, url, id) }} - see README #}
{# id only when the anchor is set: an empty id="" is invalid HTML, and would be a duplicate of every other one #}
<div class="social-share social-share--shape-{{ shape }} social-share--fill-{{ fill }} social-share--{{ alignment }}"{% if id|default('') %} id="{{ id }}"{% endif %} data-controller="shareButtonsPopup">
    {% for button in buttons %}
        <a
            href="{{ button.url }}"
            class="social-share-btn social-share-btn--{{ button.network }}"
            aria-label="{{ 'label.share_on'|trans({'%network%': button.network|capitalize}, 'social') }}"
            data-action="shareButtonsPopup#open"
            target="_blank"
            rel="noopener nofollow"
        >
            {% if displayIcon and button.icon is not empty %}
                <twig:c975LUi:Image:Icon src="{{ button.icon }}" width="24" height="24" />
            {% endif %}
            {% if displayText %}
                {{ button.network|capitalize }}
            {% endif %}
        </a>
    {% endfor %}
</div>
