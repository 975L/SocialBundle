{# {{ share_buttons(networks, shape, fill, alignment, displayIcon, displayText, url, id, displayIntro) }} - see README #}
{# id only when the anchor is set: an empty id="" is invalid HTML, and would be a duplicate of every other one #}
<div class="social-share social-share--shape-{{ shape }} social-share--fill-{{ fill }} social-share--{{ alignment }}"{% if id|default('') %} id="{{ id }}"{% endif %} data-controller="shareButtonsPopup">
    {# Inside the band, not above it: the band is what the 768px breakpoint hides on mobile, and what the anchor points at #}
    {% if displayIntro|default(false) %}
        <p class="social-share-intro">{{ 'label.share_intro'|trans({}, 'social') }}</p>
    {% endif %}
    {% for button in buttons %}
{# The "link" button copies the page's address instead of opening a network (see ShareButtonsService::COPY_NETWORK) #}
        {% set isCopy = 'link' == button.network %}
        {% set label = isCopy ? 'label.copy_link'|trans({}, 'social') : 'label.share_on'|trans({'%network%': button.network|capitalize}, 'social') %}
        <a
            href="{{ button.url }}"
            class="social-share-btn social-share-btn--{{ button.network }}"
            aria-label="{{ label }}"
            {% if isCopy %}
                title="{{ label }}"
                data-action="shareButtonsPopup#copy"
                data-copied-label="{{ 'label.link_copied'|trans({}, 'social') }}"
            {% else %}
                data-action="shareButtonsPopup#open"
                target="_blank"
            {% endif %}
            rel="noopener nofollow"
        >
            {% if displayIcon and button.icon is not empty %}
                <twig:c975LUi:Image:Icon src="{{ button.icon }}" width="24" height="24" />
            {% endif %}
            {% if displayText %}
                {{ isCopy ? label : button.network|capitalize }}
            {% endif %}
        </a>
    {% endfor %}
</div>
