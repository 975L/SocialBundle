{# Adapter spreading the stored data keys onto the component's props #}
{% if links is defined and links is not empty %}
    {# A <div>, not a <section>: this block carries no heading of its own, and a headingless <section> is invalid HTML (same fallback as UiBundle's own block components). It owns the vertical room above it, see sass/_social.scss #}
    <div class="social-links-block">
        {# Rich text (TrixEditorType), rendered raw; no wrapper at all when left empty #}
        {% if intro is defined and intro is not empty %}
            <div class="social-links-intro">{{ intro|raw }}</div>
        {% endif %}
        {# The one style showing no glyph at all: the network's name is the link, for a row set as words rather than as icons #}
        {% set textOnly = iconStyle|default('minimal') == 'text' %}
        <ul class="social-links social-links--{{ iconStyle|default('minimal') }}">
            {% for link in links %}
                {# Falls back to the url: a custom entry left without a label would otherwise name nothing and, with no glyph, leave an empty link #}
                {% set label = link.network is not empty ? link.network|capitalize : (link.customLabel ?: link.url) %}
                {% set icon = link.network is not empty ? social_link_icon(link.network) : link.customIcon %}
                <li class="social-link social-link--{{ link.network is not empty ? link.network : 'other' }}">
                    <a href="{{ link.url }}" aria-label="{{ label }}" target="_blank" rel="noopener">
                        {# No "title": the icon is decorative (Icon.html.twig writes alt="" aria-hidden="true" on it), so a title on it is an assistive-technology dead end - the link's own aria-label above is what names the network #}
                        {% if not textOnly and icon is not empty %}
                            <twig:c975LUi:Image:Icon src="{{ icon }}" width="32" height="32" class="social-link-icon" />
                        {% endif %}
                        {# Printed whatever the "display label" box says once the glyph is gone: an entry with neither would leave nothing to click #}
                        {% if textOnly or displayLabel is not defined or displayLabel %}
                            {{ label }}
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
