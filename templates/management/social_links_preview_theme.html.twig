{# The intro and the list show the last saved state, but icon style and display label are live, CSS doing the recoloring #}
{% block social_links_preview_widget %}
    {# This bundle's stylesheet only, never the app's front-end one #}
    {# Root-relative: EasyAdmin pages have no <base href>, so a bare path would 404 against the current URL #}
    <link rel="stylesheet" href="/bundles/c975lsocial/css/styles.min.css">
    <div id="sl-links-preview">
        {% if links is not empty %}
            {% if intro is not empty %}
                <div class="social-links-intro">{{ intro|raw }}</div>
            {% endif %}
            <ul class="social-links social-links--{{ icon_style }}" data-social-links-preview-list>
                {% for link in links %}
                    {# Same fallback as the real render, see blocks/SocialLinks.html.twig #}
                    {% set label = link.network is not empty ? link.network|capitalize : (link.customLabel ?: link.url) %}
                    {% set icon = link.network is not empty ? social_link_icon(link.network) : link.customIcon %}
                    <li class="social-link social-link--{{ link.network is not empty ? link.network : 'other' }}">
                        <a href="{{ link.url }}" aria-label="{{ label }}" target="_blank" rel="noopener">
                            {% if icon is not empty %}
                                <twig:c975LUi:Image:Icon src="{{ icon }}" width="32" height="32" class="social-link-icon" />
                            {% endif %}
                            {# Kept on under "text", as the real render does, so the server-side preview does not wait for the JS to fill empty rows #}
                            <span class="social-link-label"{% if not display_label and icon_style != 'text' %} hidden{% endif %}>{{ label }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
