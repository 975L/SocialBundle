{% extends '@EasyAdmin/page/content.html.twig' %}

{# The LinkedIn Pages the member administers, one picked as the site's (see SocialLinkedInPageController::index()) #}
{% block main %}
    <h1>{{ ('label.social_linkedin_page'|trans({}, 'social')) }}</h1>

    <p>{{ ('label.info_social_linkedin_page'|trans({}, 'social')) }}</p>

    <form method="post">
        <input type="hidden" name="token" value="{{ csrf_token(token) }}">

        <div class="row g-3">
            {% for organization in organizations %}
                {% embed '@c975LSocial/management/_pick_card.html.twig' with {icon: 'fab fa-linkedin', name: organization.name, id: organization.id, field: 'organization', current_label: 'label.social_linkedin_page_current', pick_label: 'label.social_linkedin_page_pick'} %}
                    {% block title %}<a href="https://www.linkedin.com/company/{{ organization.id }}/" target="_blank" rel="noopener noreferrer">{{ organization.name }}</a>{% endblock %}
                {% endembed %}
            {% endfor %}
        </div>
    </form>
{% endblock main %}
