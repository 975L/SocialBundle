{# The panel a card opens beside the calendar (see SocialCalendarController::renderPanel()): its buttons go through the same move as a drag, so a post planned here and a post dropped there are one and the same thing #}
{% import '@c975LSocial/management/social_calendar.html.twig' as calendar %}
{# The full screen of the post a link away, for what the panel leaves to it: the text every network's own is cut from, rephrased #}
<div class="social-calendar-panel-head">
    <twig:ea:Badge color="{{ {published: 'secondary', approved: 'success', failed: 'warning', draft: 'danger'}[state] }}">
        {%- if state == 'failed' -%}
            {{ 'label.social_calendar_state_failed_on'|trans({'%networks%': targets|filter(target => target.status.value == 'failed')|map(target => target.network|capitalize)|join(', ')}, 'social') }}
        {%- else -%}
            {{ ('label.social_calendar_state_' ~ state)|trans({}, 'social') }}
        {%- endif -%}
    </twig:ea:Badge>
    <div class="d-flex gap-2">
        <twig:ea:Button htmlElement="a" href="{{ post.edit_url }}" size="sm" icon="fa fa-up-right-from-square">{{ 'label.social_calendar_edit_texts'|trans({}, 'social') }}</twig:ea:Button>
        <twig:ea:Button type="button" size="sm" data-action="social-calendar#closePanel">{{ 'label.social_calendar_close'|trans({}, 'social') }}</twig:ea:Button>
    </div>
</div>

<h2 class="h5">{{ post.title }}</h2>

{# What a network would refuse in its medias, after a drop or networks ticked, warned as the post's screen does #}
{% if media_problems is not empty %}
    <twig:ea:Alert variant="warning" role="status" class="small">{{ media_problems|nl2br }}</twig:ea:Alert>
{% endif %}

{# The card's network badges and state as they now read, which the card on the calendar takes #}
<template data-social-calendar-target="badges" data-post-id="{{ post.id }}" data-state="{{ state }}">{{ calendar.networks(post.networks, connected) }}</template>

{# Its approval first - the series' too, offered on any of its posts -, then its moment: picked in the field, then saved by its own button #}
<div class="d-flex flex-wrap gap-2">
    {% if state == 'approved' %}
        <twig:ea:Button type="button" size="sm" icon="fa fa-calendar-xmark" data-action="social-calendar#place" data-post-id="{{ post.id }}" data-to="unapprove">{{ 'label.social_post_unapprove'|trans({}, 'social') }}</twig:ea:Button>
    {% elseif state != 'published' %}
        <twig:ea:Button type="button" variant="success" size="sm" icon="fa fa-calendar-check" data-action="social-calendar#place" data-post-id="{{ post.id }}" data-to="approve">{{ 'label.social_post_approve'|trans({}, 'social') }}</twig:ea:Button>
    {% endif %}
    {# Every coming draft of the post's series approved at once, each at its own moment - not offered when the post's own "Approve" would do the same #}
    {% set own_draft = state == 'draft' and post.planned_at > date() ? 1 : 0 %}
    {% if series_drafts > own_draft %}
        <twig:ea:Button type="button" variant="success" size="sm" icon="fa fa-layer-group" data-action="social-calendar#place" data-post-id="{{ post.id }}" data-to="approve-series">{{ 'label.social_calendar_approve_series'|trans({'%count%': series_drafts}, 'social') }}</twig:ea:Button>
    {% endif %}
    {% if series_url %}
        <twig:ea:Button htmlElement="a" href="{{ series_url }}" size="sm" icon="fa fa-table-cells">{{ 'label.social_calendar_series_view'|trans({}, 'social') }}</twig:ea:Button>
    {% endif %}
    {# Written again the day after, a draft whose panel opens at once - offered on a post gone out as well #}
    <twig:ea:Button type="button" size="sm" icon="fa fa-clone" data-action="social-calendar#duplicate" data-post-id="{{ post.id }}">{{ 'label.social_calendar_duplicate'|trans({}, 'social') }}</twig:ea:Button>
</div>

{# The connected networks it goes to, ticked or unticked until it goes out anywhere, then as they stand #}
{% if offered_networks is not empty %}
    <form class="social-calendar-panel-networks" data-action="social-calendar#saveNetworks" data-post-id="{{ post.id }}">
        <fieldset class="d-grid gap-2"{% if not editable %} disabled{% endif %}>
            <legend class="form-label small mb-0">{{ 'label.social_post_send_on'|trans({}, 'social') }}</legend>
            <div class="d-flex flex-wrap gap-3">
                {% for network in offered_networks %}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="networks[]" value="{{ network }}" id="social-calendar-network-{{ post.id }}-{{ network }}"{% if network in networks %} checked{% endif %}>
                        <label class="form-check-label" for="social-calendar-network-{{ post.id }}-{{ network }}">{{ calendar.networks([network], connected) }} {{ network|capitalize }}</label>
                    </div>
                {% endfor %}
            </div>
            {% if editable %}
                <div><twig:ea:Button type="submit" size="sm" icon="fa fa-floppy-disk">{{ 'label.social_calendar_save_networks'|trans({}, 'social') }}</twig:ea:Button></div>
            {% endif %}
        </fieldset>
    </form>
{% endif %}

{% if state != 'published' %}
    <div class="social-calendar-panel-plan">
        <label for="social-calendar-plan-{{ post.id }}" class="form-label small">{{ 'label.social_calendar_plan_at'|trans({}, 'social') }}</label>
        <div class="d-flex gap-2">
            <input type="datetime-local" step="900" class="form-control" id="social-calendar-plan-{{ post.id }}" value="{{ post.planned_at|date('Y-m-d\\TH:i') }}" data-social-calendar-target="planAt">
            <twig:ea:Button type="button" size="sm" icon="fa fa-clock" data-action="social-calendar#plan" data-post-id="{{ post.id }}">{{ 'label.social_calendar_plan'|trans({}, 'social') }}</twig:ea:Button>
        </div>
        <p class="small text-muted mb-0">{{ 'help.social_calendar_plan'|trans({}, 'social') }}</p>
    </div>
{% endif %}

{# The medias as they go out, in their order: dragged to another place, or taken off the post - the content's own picture shown while the post has none #}
<div data-social-calendar-target="thumbnail" data-post-id="{{ post.id }}" data-image="{{ post.image }}">
    {% if medias is not empty %}
        <ul class="social-calendar-panel-medias">
            {% for media in medias %}
                <li {% if editable %}data-social-calendar-target="media" data-post-id="{{ post.id }}"{% endif %} data-media-id="{{ media.id }}">
                    {% if media.video %}
                        {# A moment in rather than the first frame, often black, and a play sign over it: a video reads as one at a glance. Focusable and opened by Enter or Space too, a <button> around it keeping the media from being dragged (see mediaTargetConnected) #}
                        <video src="{{ media.publicPath }}#t=1" preload="metadata" muted tabindex="0" role="button" data-action="click->social-calendar#zoom keydown.enter->social-calendar#zoom keydown.space->social-calendar#zoom" title="{{ 'label.social_calendar_media_play'|trans({}, 'social') }}" aria-label="{{ 'label.social_calendar_media_play'|trans({}, 'social') }}"></video>
                        <span class="social-calendar-panel-play" aria-hidden="true"><i class="fa fa-play"></i></span>
                    {% else %}
                        {# UiBundle's lightbox, the stored file being the only one a media of the post has #}
                        <twig:c975LUi:Image:Zoom src="{{ media.publicPath }}" highres="{{ media.publicPath }}" alt="{{ media.alt }}" label="{{ 'label.social_calendar_media_zoom'|trans({}, 'social') }}" priority="false" />
                    {% endif %}
                    {% if editable %}
                        <twig:ea:Button type="button" variant="danger" size="sm" icon="fa fa-trash" data-action="social-calendar#removeMedia" data-post-id="{{ post.id }}" data-media-id="{{ media.id }}" data-confirm="{{ 'label.social_calendar_media_remove_confirm'|trans({}, 'social') }}" title="{{ 'label.social_calendar_media_remove'|trans({}, 'social') }}" aria-label="{{ 'label.social_calendar_media_remove'|trans({}, 'social') }}" />
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        {% if editable and medias|length > 1 %}
            <p class="small text-muted mb-0">{{ 'help.social_calendar_medias'|trans({}, 'social') }}</p>
        {% endif %}
    {% elseif post.image %}
        <twig:c975LUi:Image:Zoom src="{{ post.image }}" highres="{{ post.image }}" class="social-calendar-panel-content" label="{{ 'label.social_calendar_media_zoom'|trans({}, 'social') }}" priority="false" />
    {% endif %}
</div>

{# Pictures and videos of the post's own, dropped here or picked from the computer, added after its medias #}
{% if editable %}
    <label class="social-calendar-panel-drop" data-social-calendar-target="drop" data-post-id="{{ post.id }}" data-uploading="{{ 'label.social_calendar_uploading'|trans({}, 'social') }}">
        <input type="file" class="visually-hidden" multiple accept="{{ accepted_types }}" data-action="social-calendar#pickFiles">
        <i class="fa fa-cloud-arrow-up fa-lg" aria-hidden="true"></i>
        <span class="social-calendar-panel-drop-label">{{ 'label.social_calendar_drop'|trans({}, 'social') }}</span>
        <span class="small text-muted">{{ 'help.social_calendar_drop'|trans({}, 'social') }}</span>
    </label>
{% endif %}

{% if editable and (pick_media_url or change_content_url) %}
    <div class="d-flex flex-wrap gap-2">
        {% if pick_media_url %}<twig:ea:Button htmlElement="a" href="{{ pick_media_url }}" size="sm" icon="fa fa-images">{{ 'label.social_media_pick'|trans({}, 'social') }}</twig:ea:Button>{% endif %}
        {% if change_content_url %}<twig:ea:Button htmlElement="a" href="{{ change_content_url }}" size="sm" icon="fa fa-shuffle">{{ 'label.social_content_change'|trans({}, 'social') }}</twig:ea:Button>{% endif %}
    </div>
{% endif %}

{# Each network's text, corrected here and saved together - one gone out on its network read only #}
<form class="social-calendar-panel-texts" data-action="social-calendar#saveTexts" data-post-id="{{ post.id }}">
    {% for key, target in targets %}
        <div class="social-calendar-panel-text">
            <label class="small d-flex justify-content-between"{% if target.pending %} for="social-calendar-text-{{ target.id }}"{% endif %}>
                <span>{{ calendar.networks([target.network], connected) }} {{ target.network|capitalize }}</span>
                <span>{{ target.status|trans }}</span>
            </label>
            {% if target.pending %}
                <textarea class="form-control" id="social-calendar-text-{{ target.id }}" name="texts[{{ target.id }}]" rows="6" required {% if max_lengths[key] %}maxlength="{{ max_lengths[key] }}"{% endif %}>{{ target.text }}</textarea>
            {% else %}
                <div class="social-calendar-panel-body">{{ target.text }}</div>
            {% endif %}
            {# A network that refused the post, its first comment, its reshare or its story: why, then sent again at once on it alone #}
            {% if target.status.value == 'failed' or target.followUpPending %}
                {% if target.status.value == 'failed' %}
                    <p class="small text-danger mb-1">{{ target.error }}</p>
                {% endif %}
                {% if target.commentPending %}
                    <p class="small text-danger mb-1">{{ 'email.social_post_comment_failed'|trans({'%error%': target.commentError}, 'social') }}</p>
                {% endif %}
                {% if target.resharePending %}
                    <p class="small text-danger mb-1">{{ 'email.social_post_reshare_failed'|trans({'%error%': target.reshareError}, 'social') }}</p>
                {% endif %}
                {% if target.storyPending %}
                    <p class="small text-danger mb-1">{{ 'email.social_post_story_failed'|trans({'%error%': target.storyError}, 'social') }}</p>
                {% endif %}
                <twig:ea:Button type="button" variant="warning" size="sm" icon="fa fa-paper-plane" data-action="social-calendar#retry" data-post-id="{{ post.id }}" data-network="{{ target.network }}">{{ (target.status.value == 'failed' ? 'label.social_calendar_retry' : (target.commentPending ? 'label.social_calendar_retry_comment' : (target.resharePending ? 'label.social_calendar_retry_reshare' : 'label.social_calendar_retry_story')))|trans({'%network%': target.network|capitalize}, 'social') }}</twig:ea:Button>
            {% endif %}
        </div>
    {% endfor %}
    {% if texts_saved %}
        <p class="small text-success mb-0">{{ 'label.social_calendar_texts_saved'|trans({}, 'social') }}</p>
    {% endif %}
    {% if targets|filter(target => target.pending) is not empty %}
        <twig:ea:Button type="submit" variant="primary" size="sm" icon="fa fa-floppy-disk">{{ 'label.social_calendar_save_texts'|trans({}, 'social') }}</twig:ea:Button>
    {% endif %}
</form>
