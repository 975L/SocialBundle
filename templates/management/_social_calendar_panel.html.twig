{# The panel a card opens beside the calendar (see SocialCalendarController::renderPanel()): its buttons go through the same move as a drag, so a post planned here and a post dropped there are one and the same thing #}
{% import '@c975LSocial/management/social_calendar.html.twig' as calendar %}
<div class="social-calendar-panel-head">
    <twig:ea:Badge variant="{{ {published: 'secondary', approved: 'success', failed: 'warning', draft: 'danger'}[state] }}">{{ ('label.social_calendar_state_' ~ state)|trans({}, 'social') }}</twig:ea:Badge>
    <twig:ea:Button type="button" size="sm" data-action="social-calendar#closePanel">{{ 'label.social_calendar_close'|trans({}, 'social') }}</twig:ea:Button>
</div>

<h2 class="h5">{{ post.title }}</h2>

{% if state != 'published' %}
    <div class="social-calendar-panel-plan">
        <label for="social-calendar-plan-{{ post.id }}" class="form-label small">{{ 'label.social_calendar_plan_at'|trans({}, 'social') }}</label>
        <input type="datetime-local" step="900" class="form-control" id="social-calendar-plan-{{ post.id }}" value="{{ post.planned_at|date('Y-m-d\\TH:i') }}" data-social-calendar-target="planAt">
        <div class="d-flex flex-wrap gap-2 mt-2">
            <twig:ea:Button type="button" size="sm" data-action="social-calendar#plan" data-post-id="{{ post.id }}">{{ 'label.social_calendar_plan'|trans({}, 'social') }}</twig:ea:Button>
            {% if state == 'approved' %}
                <twig:ea:Button type="button" size="sm" data-action="social-calendar#place" data-post-id="{{ post.id }}" data-to="unapprove">{{ 'label.social_post_unapprove'|trans({}, 'social') }}</twig:ea:Button>
            {% else %}
                <twig:ea:Button type="button" variant="success" size="sm" data-action="social-calendar#place" data-post-id="{{ post.id }}" data-to="approve">{{ 'label.social_post_approve'|trans({}, 'social') }}</twig:ea:Button>
            {% endif %}
        </div>
    </div>
{% endif %}

{# The medias as they go out, in their order: dragged to another place, or taken off the post - the content's own picture shown while the post has none #}
<div data-social-calendar-target="thumbnail" data-post-id="{{ post.id }}" data-image="{{ post.image }}">
    {% if medias is not empty %}
        <ul class="social-calendar-panel-medias">
            {% for media in medias %}
                <li {% if editable %}data-social-calendar-target="media" data-post-id="{{ post.id }}"{% endif %} data-media-id="{{ media.id }}">
                    {% if media.video %}
                        <video src="{{ media.publicPath }}" preload="metadata" muted></video>
                    {% else %}
                        <img src="{{ media.publicPath }}" alt="{{ media.alt }}" loading="lazy" draggable="false">
                    {% endif %}
                    {% if editable %}
                        <twig:ea:Button type="button" variant="danger" size="sm" icon="fa fa-trash" data-action="social-calendar#removeMedia" data-post-id="{{ post.id }}" data-media-id="{{ media.id }}" data-confirm="{{ 'label.social_calendar_media_remove_confirm'|trans({}, 'social') }}" title="{{ 'label.social_calendar_media_remove'|trans({}, 'social') }}" aria-label="{{ 'label.social_calendar_media_remove'|trans({}, 'social') }}" />
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        {% if editable and medias|length > 1 %}
            <p class="small text-muted mb-0">{{ 'help.social_calendar_medias'|trans({}, 'social') }}</p>
        {% endif %}
    {% elseif post.image %}
        <img src="{{ post.image }}" alt="" loading="lazy" class="social-calendar-panel-content">
    {% endif %}
</div>

{% if editable and (pick_media_url or change_content_url) %}
    <div class="d-flex flex-wrap gap-2">
        {% if pick_media_url %}<twig:ea:Button htmlElement="a" href="{{ pick_media_url }}" size="sm" icon="fa fa-images">{{ 'label.social_media_pick'|trans({}, 'social') }}</twig:ea:Button>{% endif %}
        {% if change_content_url %}<twig:ea:Button htmlElement="a" href="{{ change_content_url }}" size="sm" icon="fa fa-shuffle">{{ 'label.social_content_change'|trans({}, 'social') }}</twig:ea:Button>{% endif %}
    </div>
{% endif %}

{% for target in targets %}
    <div class="social-calendar-panel-text">
        <div class="small d-flex justify-content-between">
            <span>{{ calendar.networks([target.network], connected) }} {{ target.network|capitalize }}</span>
            <span>{{ target.status|trans }}</span>
        </div>
        <div class="social-calendar-panel-body">{{ target.text }}</div>
    </div>
{% endfor %}

<twig:ea:Button htmlElement="a" href="{{ post.edit_url }}" size="sm">{{ 'label.social_calendar_edit_texts'|trans({}, 'social') }}</twig:ea:Button>
