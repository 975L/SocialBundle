{% extends '@EasyAdmin/page/content.html.twig' %}

{# The week - or the month - of publications (see SocialCalendarController): a card is dragged onto a coming moment, and opened with a click #}
{% macro networks(networks, connected) %}
    <span class="social-network-badges">
        {%- for network in networks -%}
            {%- set icon = social_link_icon(network) -%}
            <span class="social-network-badge social-network-badge--{{ network }}{{ network in connected ? '' : ' is-off' }}" title="{{ network|capitalize }}{{ network in connected ? '' : ' - ' ~ 'label.network_off'|trans({}, 'social') }}">
                {%- if icon %}<img src="{{ asset(icon) }}" alt="">{% else %}{{ network|first|upper }}{% endif -%}
            </span>
        {%- endfor -%}
    </span>
{% endmacro %}

{# A post on the calendar, coloured by its state: one gone out everywhere only opens, any other is dragged to another moment #}
{% macro card(post, connected) %}
    {% set draggable = post.state != 'published' %}
    <a href="{{ post.edit_url }}" draggable="false" data-action="social-calendar#open" data-panel-id="{{ post.id }}"
        class="social-calendar-card is-{{ post.state }}"
        {% if draggable %}data-social-calendar-target="item" data-post-id="{{ post.id }}" data-at="{{ post.planned_at|date('c') }}"{% endif %}>
        {% if post.image %}<img src="{{ post.image }}" alt="" loading="lazy">{% endif %}
        <span>{{ post.title }}</span>
        {{ _self.networks(post.networks, connected) }}
    </a>
{% endmacro %}

{% block main %}

    <div data-controller="social-calendar"
        data-social-calendar-url-value="{{ move_url }}"
        data-social-calendar-token-value="{{ csrf_token(token) }}"
        data-social-calendar-panel-url-value="{{ panel_url }}"
        data-social-calendar-new-url-value="{{ new_url }}"
        data-social-calendar-failed-label-value="{{ 'label.social_calendar_move_failed'|trans({}, 'social') }}">

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h1 class="mb-0">{{ 'label.social_calendar'|trans({}, 'social') }} - {{ title|capitalize }}</h1>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary social-calendar-new" href="{{ new_url }}"><i class="fa fa-plus"></i> {{ 'label.social_calendar_new'|trans({}, 'social') }}</a>
                <a class="btn btn-secondary social-calendar-series" href="{{ series_url }}"><i class="fa fa-layer-group"></i> {{ 'label.social_series_generate'|trans({}, 'social') }}</a>
                <div class="btn-group">
                    <a class="btn {{ view == 'week' ? 'btn-primary' : 'btn-secondary' }}" href="{{ path('management_social_calendar', {view: 'week', date: date}) }}">{{ 'label.social_calendar_week'|trans({}, 'social') }}</a>
                    <a class="btn {{ view == 'month' ? 'btn-primary' : 'btn-secondary' }}" href="{{ path('management_social_calendar', {view: 'month', date: date}) }}">{{ 'label.social_calendar_month'|trans({}, 'social') }}</a>
                </div>
                <div class="btn-group">
                    <a class="btn btn-secondary" href="{{ path('management_social_calendar', {view: view, date: previous}) }}" aria-label="{{ 'label.social_calendar_previous'|trans({}, 'social') }}"><i class="fa fa-chevron-left"></i></a>
                    <a class="btn btn-secondary" href="{{ path('management_social_calendar', {view: view}) }}">{{ 'label.social_calendar_today'|trans({}, 'social') }}</a>
                    <a class="btn btn-secondary" href="{{ path('management_social_calendar', {view: view, date: next}) }}" aria-label="{{ 'label.social_calendar_next'|trans({}, 'social') }}"><i class="fa fa-chevron-right"></i></a>
                </div>
            </div>
        </div>

        <p>{{ 'label.info_social_calendar'|trans({}, 'social') }}</p>

        {# Which networks the site is connected to: a greyed one sends nothing until it is, from "Connexions" #}
        <div class="social-calendar-networks mb-3">
            {% for network in networks %}
                <span>{{ _self.networks([network.name], connected) }} {{ network.name|capitalize }}</span>
            {% endfor %}
            <a href="{{ path(connections_route) }}">{{ 'label.social_connections'|trans({}, 'social') }}</a>
        </div>

        <p class="small text-muted">{{ 'label.social_calendar_drag_hint'|trans({}, 'social') }}</p>

        {% if view == 'week' %}
                    {# A week of quarters of an hour: each coming one a drop zone planning the card at that very moment, the items laid over them at the quarter they stand at #}
                    <div class="social-week-scroll"><div class="social-week">
                        <div class="social-week-hours">
                            <div class="social-week-head"></div>
                            {% for hour in hours %}<div class="social-week-hour">{{ hour }}</div>{% endfor %}
                        </div>
                        {% for day in weeks|first %}
                            <div class="social-week-day{{ day.today ? ' is-today' : '' }}">
                                <div class="social-week-head">{{ weekdays[loop.index0]|capitalize }} {{ day.date|date('d/m') }}</div>
                                <div class="social-week-body">
                                    {% for cell in day.cells %}
                                        <div class="social-week-cell{{ cell.open ? '' : ' is-past' }}"{% if cell.open %} data-social-calendar-target="zone" data-to="{{ cell.at|date('c') }}" data-action="dblclick->social-calendar#create"{% endif %}></div>
                                    {% endfor %}
                                    {% for group in day.rows %}
                                        <div class="social-week-items" style="--row: {{ group.row }}; --lane: {{ group.lane }}; --lanes: {{ group.lanes }}">
                                            {% for item in group.items %}{{ _self.card(item, connected) }}{% endfor %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div></div>
                {% else %}
                    <div class="social-calendar">
                        {% for weekday in weekdays %}
                            <div class="social-calendar-weekday">{{ weekday|capitalize }}</div>
                        {% endfor %}

                        {% for week in weeks %}
                            {% for day in week %}
                                <div class="social-calendar-day{{ day.in_month ? '' : ' is-other-month' }}{{ day.today ? ' is-today' : '' }}{{ day.items is empty ? ' is-empty' : '' }}"{% if day.open %} data-social-calendar-target="zone" data-to="{{ day.date|date('Y-m-d') }}" data-action="dblclick->social-calendar#create"{% endif %}>
                                    <div class="social-calendar-date">{{ day.date|date('d/m') }}</div>
                                    {% for item in day.items %}{{ _self.card(item, connected) }}{% endfor %}
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </div>
        {% endif %}

        {# Filled by social-calendar.js with the panel of the card clicked (see _social_calendar_panel.html.twig) #}
        <aside class="social-calendar-panel" data-social-calendar-target="panel" hidden></aside>
    </div>
{% endblock %}
