{% extends '@EasyAdmin/page/content.html.twig' %}

{# The week - or the day, or the month - of publications (see SocialCalendarController): a card is dragged onto a coming moment, and opened with a click #}
{% macro networks(networks, connected) %}
    <span class="social-network-badges">
        {%- for network in networks -%}
            {%- set icon = social_link_icon(network) -%}
            <span class="social-network-badge social-network-badge--{{ network }}{{ network in connected ? '' : ' is-off' }}" title="{{ network|capitalize }}{{ network in connected ? '' : ' - ' ~ 'label.network_off'|trans({}, 'social') }}">
                {%- if icon %}<img src="{{ asset(icon) }}" alt="">{% else %}{{ network|first|upper }}{% endif -%}
            </span>
        {%- endfor -%}
    </span>
{% endmacro %}

{# A post on the calendar, coloured by its state: one gone out everywhere only opens, any other is dragged to another moment #}
{% macro card(post, connected) %}
    {% set draggable = post.state != 'published' %}
    <a href="{{ post.edit_url }}" draggable="false" data-action="social-calendar#open" data-panel-id="{{ post.id }}" data-panel-card
        class="social-calendar-card is-{{ post.state }}"
        {% if draggable %}data-social-calendar-target="item" data-post-id="{{ post.id }}" data-at="{{ post.planned_at|date('c') }}"{% endif %}>
        {% if post.image %}<img src="{{ post.image }}" alt="" loading="lazy">{% endif %}
        {# A video going out with it, which its picture does not show #}
        {% if post.video %}{% set video_label = 'label.social_calendar_has_video'|trans({}, 'social') %}<i class="fa fa-film social-calendar-card-video" role="img" title="{{ video_label }}" aria-label="{{ video_label }}"></i>{% endif %}
        <span>{{ post.title }}</span>
        {{ _self.networks(post.networks, connected) }}
    </a>
{% endmacro %}

{% block main %}

    <div data-controller="social-calendar"
        data-action="keydown.esc@window->social-calendar#closePanel"
        {{ include('@c975LSocial/management/_social_calendar_values.html.twig') }}
        data-social-calendar-new-url-value="{{ new_url }}">

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
            <h1 class="mb-0">{{ 'label.social_calendar'|trans({}, 'social') }} - {{ title|capitalize }}</h1>
            <div class="d-flex flex-wrap gap-2">
                <twig:ea:Button htmlElement="a" href="{{ new_url }}" variant="primary" icon="fa fa-plus" class="social-calendar-new">{{ 'label.social_calendar_new'|trans({}, 'social') }}</twig:ea:Button>
                <twig:ea:Button htmlElement="a" href="{{ series_url }}" icon="fa fa-layer-group" class="social-calendar-series">{{ 'label.social_series_generate'|trans({}, 'social') }}</twig:ea:Button>
                <div class="btn-group">
                    <twig:ea:Button htmlElement="a" href="{{ path('management_social_calendar', {view: 'day', date: day_date}) }}" variant="{{ view == 'day' ? 'primary' : 'default' }}">{{ 'label.social_calendar_day'|trans({}, 'social') }}</twig:ea:Button>
                    <twig:ea:Button htmlElement="a" href="{{ path('management_social_calendar', {view: 'week', date: date}) }}" variant="{{ view == 'week' ? 'primary' : 'default' }}">{{ 'label.social_calendar_week'|trans({}, 'social') }}</twig:ea:Button>
                    <twig:ea:Button htmlElement="a" href="{{ path('management_social_calendar', {view: 'month', date: date}) }}" variant="{{ view == 'month' ? 'primary' : 'default' }}">{{ 'label.social_calendar_month'|trans({}, 'social') }}</twig:ea:Button>
                </div>
                <div class="btn-group">
                    <twig:ea:Button htmlElement="a" href="{{ path('management_social_calendar', {view: view, date: previous}) }}" icon="fa fa-chevron-left" aria-label="{{ 'label.social_calendar_previous'|trans({}, 'social') }}" />
                    <twig:ea:Button htmlElement="a" href="{{ path('management_social_calendar', {view: view}) }}">{{ 'label.social_calendar_today'|trans({}, 'social') }}</twig:ea:Button>
                    <twig:ea:Button htmlElement="a" href="{{ path('management_social_calendar', {view: view, date: next}) }}" icon="fa fa-chevron-right" aria-label="{{ 'label.social_calendar_next'|trans({}, 'social') }}" />
                </div>
            </div>
        </div>

        <p>{{ 'label.info_social_calendar'|trans({}, 'social') }}</p>

        {# Which networks the site is connected to: a greyed one sends nothing until it is, from "Connexions" #}
        <div class="social-calendar-networks mb-3">
            {% for network in networks %}
                <span>{{ _self.networks([network.name], connected) }} {{ network.name|capitalize }}</span>
            {% endfor %}
            <a href="{{ path(connections_route) }}">{{ 'label.social_connections'|trans({}, 'social') }}</a>
        </div>

        {# What a card's look says of its post #}
        <div class="social-calendar-legend mb-2">
            {% for state in ['draft', 'approved', 'failed', 'published'] %}
                <span class="social-calendar-card is-{{ state }} is-legend"><span>{{ ('label.social_calendar_state_' ~ state)|trans({}, 'social') }}</span></span>
            {% endfor %}
        </div>

        <p class="small text-muted">{{ 'label.social_calendar_drag_hint'|trans({}, 'social') }}</p>

        {# The calendar subscribed to from Outlook, Evolution or Google Calendar by its secret address (see SocialCalendarFeed) #}
        <details class="social-calendar-feed mb-3">
            <summary class="small">{{ 'label.social_calendar_feed'|trans({}, 'social') }}</summary>
            {% if feed_url %}
                <input type="text" class="form-control form-control-sm mt-2" value="{{ feed_url }}" readonly aria-label="{{ 'label.social_calendar_feed'|trans({}, 'social') }}">
            {% endif %}
            <p class="small text-muted mt-2 mb-2">{{ (feed_url ? 'help.social_calendar_feed' : 'help.social_calendar_feed_none')|trans({}, 'social') }}</p>
            <form method="post" action="{{ feed_token_url }}">
                <input type="hidden" name="token" value="{{ csrf_token(token) }}">
                <twig:ea:Button size="sm" icon="fa fa-calendar-plus">{{ (feed_url ? 'label.social_calendar_feed_renew' : 'label.social_calendar_feed_create')|trans({}, 'social') }}</twig:ea:Button>
            </form>
        </details>

        {% if view != 'month' %}
                    {# A week - or a day - of quarters of an hour: each coming one a drop zone planning the card at that very moment, the items laid over them at the quarter they stand at #}
                    <div class="social-week-scroll"><div class="social-week{{ view == 'day' ? ' social-week--day' : '' }}">
                        <div class="social-week-hours">
                            <div class="social-week-head"></div>
                            {% for hour in hours %}<div class="social-week-hour">{{ hour }}</div>{% endfor %}
                        </div>
                        {% for day in weeks|first %}
                            <div class="social-week-day{{ day.today ? ' is-today' : '' }}">
                                {# The day shown is not a link to itself #}
                                {% set head = weekdays[loop.index0]|capitalize ~ ' ' ~ day.date|date('d/m') %}
                                <div class="social-week-head">{% if view == 'day' %}{{ head }}{% else %}<a href="{{ path('management_social_calendar', {view: 'day', date: day.date|date('Y-m-d')}) }}">{{ head }}</a>{% endif %}</div>
                                <div class="social-week-body">
                                    {% for cell in day.cells %}
                                        <div class="social-week-cell{{ cell.open ? '' : ' is-past' }}"{% if cell.open %} data-social-calendar-target="zone" data-to="{{ cell.at|date('c') }}" data-action="dblclick->social-calendar#create"{% endif %}></div>
                                    {% endfor %}
                                    {% for group in day.rows %}
                                        <div class="social-week-items" data-social-calendar-target="group" data-row="{{ group.row }}" data-lane="{{ group.lane }}" data-lanes="{{ group.lanes }}">
                                            {% for item in group.items %}{{ _self.card(item, connected) }}{% endfor %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div></div>
                {% else %}
                    <div class="social-calendar">
                        {% for weekday in weekdays %}
                            <div class="social-calendar-weekday">{{ weekday|capitalize }}</div>
                        {% endfor %}

                        {% for week in weeks %}
                            {% for day in week %}
                                <div class="social-calendar-day{{ day.in_month ? '' : ' is-other-month' }}{{ day.today ? ' is-today' : '' }}{{ day.items is empty ? ' is-empty' : '' }}"{% if day.open %} data-social-calendar-target="zone" data-to="{{ day.date|date('Y-m-d') }}" data-action="dblclick->social-calendar#create"{% endif %}>
                                    <div class="social-calendar-date"><a href="{{ path('management_social_calendar', {view: 'day', date: day.date|date('Y-m-d')}) }}">{{ day.date|date('d/m') }}</a></div>
                                    {% for item in day.items %}{{ _self.card(item, connected) }}{% endfor %}
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </div>
        {% endif %}

        {# Filled by social-calendar.js with the panel of the card clicked (see _social_calendar_panel.html.twig) #}
        <aside class="social-calendar-panel" data-social-calendar-target="panel" hidden></aside>

        {# A video of the panel at its own size, filled by social-calendar.js - its pictures open in UiBundle's lightbox #}
        <dialog class="social-calendar-zoom" data-social-calendar-target="zoom" data-action="click->social-calendar#closeZoom close->social-calendar#clearZoom"></dialog>
    </div>
{% endblock %}
