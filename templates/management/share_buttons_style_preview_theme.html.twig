{# Overrides the preview and "networks" widgets, registered via Crud::addFormTheme() #}

{# Every known network is rendered, the preview script hiding and reordering them live #}
{% block share_buttons_style_preview_widget %}
    {# This bundle's stylesheet only, never the app's front-end one #}
    {# Root-relative: EasyAdmin pages have no <base href>, so a bare path would 404 against the current URL #}
    <link rel="stylesheet" href="/bundles/c975lsocial/css/styles.min.css">
    {# "social-share--preview-backdrop" is added/removed here by assets/js/share-buttons-preview.js, only while the "transparent" fill is picked - see the class in sass/_share-buttons.scss #}
    <div id="ss-style-preview">
        {{ share_buttons(all_networks, 'wide', 'solid') }}
    </div>
{% endblock %}

{# Draggable checkbox list; the order is read back off the checkboxes' DOM order, no position field needed #}
{% block share_buttons_networks_widget %}
    <style>
        /* Scoped to this field only, too little CSS to warrant its own management stylesheet */
        .ss-networks-sortable { list-style: none; margin: 0; padding: 0; }
        .ss-networks-sortable-item { display: flex; align-items: center; gap: .5em; padding: .25em 0; }
        .ss-networks-sortable-item.ss-dragging { opacity: .4; }
        .ss-drag-handle { cursor: grab; user-select: none; color: var(--bs-secondary, #6c757d); }
    </style>
    <ul class="ss-networks-sortable" data-share-networks-sortable {{ block('widget_container_attributes') }}>
        {%- for child in form %}
            <li class="ss-networks-sortable-item">
                <span class="ss-drag-handle" aria-hidden="true">&#10021;</span>
                {{ form_widget(child) }}
                {{ form_label(child, null, {translation_domain: choice_translation_domain}) }}
            </li>
        {% endfor -%}
    </ul>
{% endblock %}
