{% extends '@EasyAdmin/page/content.html.twig' %}

{# One tile per network, connected or not (see SocialConnectionsController) #}
{% block main %}
    <h1>{{ ('label.social_connections'|trans({}, 'social')) }}</h1>

    <p>{{ ('label.info_social_connections'|trans({}, 'social')) }}</p>

    <div class="row g-3">
        {% for network in networks %}
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">
                            <i class="{{ network.icon }} me-2"></i>{{ ('label.network_' ~ network.name)|trans({}, 'social') }}
                        </h2>

                        {% if network.connected %}
                            <p><twig:ea:Badge color="success">{{ ('label.connection_connected'|trans({}, 'social')) }}</twig:ea:Badge></p>
                        {% elseif network.configured %}
                            <p><twig:ea:Badge>{{ ('label.connection_not_connected'|trans({}, 'social')) }}</twig:ea:Badge></p>
                        {% else %}
                            <p><twig:ea:Badge color="warning">{{ ('label.connection_not_configured'|trans({}, 'social')) }}</twig:ea:Badge></p>
                        {% endif %}

                        <p class="card-text">{{ ('label.info_' ~ network.name ~ '_connect')|trans({}, 'social') }}</p>

                        {# The accounts the connection reaches, each opened on its network #}
                        {% if network.connected and network.accounts is not empty %}
                            <ul class="list-unstyled card-text small">
                                {% for account in network.accounts %}
                                    <li>
                                        <i class="{{ account.icon }} me-2"></i>
                                        {%- if account.url %}<a href="{{ account.url }}" target="_blank" rel="noopener noreferrer">{{ account.name|trans }}</a>{% else %}{{ account.name|trans }}{% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}

                        {% if network.connected and network.expires_at is defined and network.expires_at %}
                            <p class="card-text small">{{ ('label.connection_expires'|trans({'%date%': network.expires_at|date('d/m/Y')}, 'social')) }}</p>
                        {% endif %}

                        {% if network.connected and network.instagram is defined and not network.instagram %}
                            <p class="card-text small text-warning">{{ ('label.connection_instagram_missing'|trans({}, 'social')) }}</p>
                        {% endif %}

                        {% if network.connected and (network.board_missing ?? false) %}
                            <p class="card-text small text-warning">{{ ('label.connection_pinterest_board_missing'|trans({}, 'social')) }}</p>
                        {% endif %}

                        {% if network.connected and (network.outdated ?? false) %}
                            <p class="card-text small text-warning">{{ ('label.connection_scope_outdated'|trans({}, 'social')) }}</p>
                        {% endif %}

                        <div class="mt-auto">
                            {% if not network.configured %}
                                <p class="card-text small">{{ ('label.info_' ~ network.name ~ '_not_configured')|trans({}, 'social') }}</p>
                            {% elseif network.site_url is defined and network.site_url %}
                                {# Bluesky knows the site by "site-url" only: started from here, it would refuse the connection #}
                                <p class="card-text small">{{ ('label.connection_wrong_host'|trans({'%url%': network.site_url}, 'social')) }}</p>
                            {% elseif network.page_button ?? false %}
                                {# LinkedIn posts on the member's profile or on a Page they administer, each its own consent through the same route #}
                                <twig:ea:Button htmlElement="a" href="{{ path(network.route) }}" variant="{{ network.connected ? 'default' : 'primary' }}">
                                    {{ ('label.connection_connect_profile'|trans({}, 'social')) }}
                                </twig:ea:Button>
                                <twig:ea:Button htmlElement="a" href="{{ path(network.route, {page: 1}) }}" variant="{{ network.connected ? 'default' : 'primary' }}">
                                    {{ ('label.connection_connect_page'|trans({}, 'social')) }}
                                </twig:ea:Button>
                            {% else %}
                                <twig:ea:Button htmlElement="a" href="{{ path(network.route) }}" variant="{{ network.connected and not (network.outdated ?? false) ? 'default' : 'primary' }}">
                                    {{ (network.connected ? 'label.connection_reconnect' : 'label.connection_connect')|trans({}, 'social') }}
                                </twig:ea:Button>
                                {# Pinterest pins on one board of the account, picked again from here #}
                                {% if network.connected and network.board_route is defined %}
                                    <twig:ea:Button htmlElement="a" href="{{ path(network.board_route) }}" variant="{{ network.board_missing ? 'primary' : 'default' }}">
                                        {{ ('label.social_pinterest_board'|trans({}, 'social')) }}
                                    </twig:ea:Button>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock main %}
