{% extends '@EasyAdmin/page/content.html.twig' %}

{# One tile per network, connected or not (see SocialConnectionsController) #}
{% block main %}
    <h1>{{ ('label.social_connections'|trans({}, 'social')) }}</h1>

    <p>{{ ('label.info_social_connections'|trans({}, 'social')) }}</p>

    <div class="row g-3">
        {% for network in networks %}
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">
                            <i class="{{ network.icon }} me-2"></i>{{ ('label.network_' ~ network.name)|trans({}, 'social') }}
                        </h2>

                        {% if network.connected %}
                            <p><span class="badge badge-success">{{ ('label.connection_connected'|trans({}, 'social')) }}</span></p>
                        {% elseif network.configured %}
                            <p><span class="badge badge-secondary">{{ ('label.connection_not_connected'|trans({}, 'social')) }}</span></p>
                        {% else %}
                            <p><span class="badge badge-warning">{{ ('label.connection_not_configured'|trans({}, 'social')) }}</span></p>
                        {% endif %}

                        <p class="card-text">{{ ('label.info_' ~ network.name ~ '_connect')|trans({}, 'social') }}</p>

                        {% if network.connected and network.account %}
                            <p class="card-text small">{{ ('label.connection_account'|trans({'%account%': network.account}, 'social')) }}</p>
                        {% endif %}

                        {% if network.connected and network.expires_at is defined and network.expires_at %}
                            <p class="card-text small">{{ ('label.connection_expires'|trans({'%date%': network.expires_at|date('d/m/Y')}, 'social')) }}</p>
                        {% endif %}

                        {% if network.connected and network.instagram is defined and not network.instagram %}
                            <p class="card-text small text-warning">{{ ('label.connection_instagram_missing'|trans({}, 'social')) }}</p>
                        {% endif %}

                        <div class="mt-auto">
                            {% if not network.configured %}
                                <p class="card-text small">{{ ('label.info_' ~ network.name ~ '_not_configured')|trans({}, 'social') }}</p>
                            {% elseif network.site_url is defined and network.site_url %}
                                {# Bluesky knows the site by "site-url" only: started from here, it would refuse the connection #}
                                <p class="card-text small">{{ ('label.connection_wrong_host'|trans({'%url%': network.site_url}, 'social')) }}</p>
                            {% else %}
                                <a href="{{ path(network.route) }}" class="btn {{ network.connected ? 'btn-secondary' : 'btn-primary' }}">
                                    {{ (network.connected ? 'label.connection_reconnect' : 'label.connection_connect')|trans({}, 'social') }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock main %}
