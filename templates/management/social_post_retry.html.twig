{% extends '@EasyAdmin/page/content.html.twig' %}

{# A post a network refused, opened from the email announcing it (see SocialPostCrudController::retryPost()): why, then sent again once confirmed - or opened to be corrected first #}
{% block main %}
    <h1>{{ 'label.social_post_retry'|trans({}, 'social') }}</h1>

    <p><strong>{{ post.title }}</strong> - {{ post.plannedAt|date('d/m/Y H:i') }}</p>

    {% for target in failed %}
        <twig:ea:Alert variant="warning" role="status" class="small mb-2">{{ target.network|capitalize }} : {{ target.error }}</twig:ea:Alert>
    {% else %}
        <p class="text-muted">{{ 'label.social_post_retry_none'|trans({}, 'social') }}</p>
    {% endfor %}

    <form method="post" class="d-flex flex-wrap gap-2 mt-3">
        <input type="hidden" name="token" value="{{ csrf_token('social_post_publish') }}">
        <twig:ea:Button name="retry" variant="primary" icon="fa fa-paper-plane">{{ 'label.social_post_retry_submit'|trans({}, 'social') }}</twig:ea:Button>
        <twig:ea:Button htmlElement="a" href="{{ edit_url }}">{{ 'label.social_post_retry_edit'|trans({}, 'social') }}</twig:ea:Button>
    </form>
{% endblock main %}
