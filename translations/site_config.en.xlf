<?xml version="1.0"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="en" datatype="plaintext" original="site_config.en.xlf">
        <body>
            <trans-unit id="ynVdtEb">
                <source>description.social_ai_guidelines</source>
                <target>What the site's AI has to know to write your posts: audience, tone, emojis, words to avoid. It uses the rephrase key; without one, the text template above writes the posts.</target>
            </trans-unit>
            <trans-unit id="kmlwOk1">
                <source>description.social_bluesky_handle</source>
                <target>Handle of the account to post on, for instance example.bsky.social.</target>
            </trans-unit>
            <trans-unit id="LYr0t5Y">
                <source>description.social_bluesky_oauth_key</source>
                <target>Generated by the site on the first connection. Changing it means connecting Bluesky again.</target>
            </trans-unit>
            <trans-unit id="4Q5pl6G">
                <source>description.social_bluesky_oauth_session</source>
                <target>Filled by "Connect Bluesky", never by hand. Emptying it disconnects the account.</target>
            </trans-unit>
            <trans-unit id="r0wZwja">
                <source>description.social_calendar_hour_end</source>
                <target>The hour at the bottom of the week view's grid (23 by default). A post outside these hours shows at the edge of the grid.</target>
            </trans-unit>
            <trans-unit id="lp2codY">
                <source>description.social_calendar_hour_start</source>
                <target>The hour at the top of the week view's grid (6 by default).</target>
            </trans-unit>
            <trans-unit id="qEOm5mf">
                <source>description.social_calendar_ics_token</source>
                <target>Secret part of the posts' iCal feed address, created or renewed from the calendar. Empty: no feed.</target>
            </trans-unit>
            <trans-unit id="qi3JaGX">
                <source>description.social_enable_share_buttons</source>
                <target>Automatically displays the share buttons on every page (settings under "Share buttons").</target>
            </trans-unit>
            <trans-unit id="TELuAM2">
                <source>description.social_google_business_account_id</source>
                <target>Google Business Profile account holding the listing, picked after connecting.</target>
            </trans-unit>
            <trans-unit id="E7lJkTq">
                <source>description.social_google_business_location_id</source>
                <target>Business listing whose reviews are imported, picked after connecting.</target>
            </trans-unit>
            <trans-unit id="R3dEfsB">
                <source>description.social_google_listing_url</source>
                <target>Public address of the listing, e.g. https://www.google.com/maps?cid=... : published as sameAs on the contact block, it ties the site and the listing into one business.</target>
            </trans-unit>
            <trans-unit id="3Uz1NWR">
                <source>description.social_google_oauth_client_id</source>
                <target>OAuth client id created in the Google Cloud console.</target>
            </trans-unit>
            <trans-unit id="pgmScSU">
                <source>description.social_google_oauth_client_secret</source>
                <target>OAuth client secret paired with the id above.</target>
            </trans-unit>
            <trans-unit id="5Phnt3P">
                <source>description.social_google_oauth_refresh_token</source>
                <target>Token obtained when connecting to Google; replacing it stops the review import.</target>
            </trans-unit>
            <trans-unit id="00x9orl">
                <source>description.social_image_format</source>
                <target>framed: the picture as it is, framed only where a network requires it. square: one 1080 x 1080 square on every network, the picture centred on the site's background colour.</target>
            </trans-unit>
            <trans-unit id="BANWhG0">
                <source>description.social_linkedin_access_token</source>
                <target>Filled by "Connect" on the LinkedIn tile of "Connections". Valid for 60 days: connect again before it expires.</target>
            </trans-unit>
            <trans-unit id="XIOiN6Y">
                <source>description.social_linkedin_client_id</source>
                <target>Client ID of the app created on linkedin.com/developers, with the "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect" products.</target>
            </trans-unit>
            <trans-unit id="2nDJLVA">
                <source>description.social_linkedin_client_secret</source>
                <target>The app's Primary Client Secret, Auth tab.</target>
            </trans-unit>
            <trans-unit id="hNZKcg8">
                <source>description.social_linkedin_member_id</source>
                <target>Filled by the connection: the profile the posts go out on.</target>
            </trans-unit>
            <trans-unit id="36ObS3d">
                <source>description.social_linkedin_token_expires_at</source>
                <target>Filled by the connection: the date after which LinkedIn refuses the token.</target>
            </trans-unit>
            <trans-unit id="kjb5dLd">
                <source>description.social_media_retention_days</source>
                <target>The photos and videos uploaded for a post gone out on all its networks are deleted after this many days, the post staying as a record. The networks keep their own copy. 0 keeps everything.</target>
            </trans-unit>
            <trans-unit id="vdijy68">
                <source>description.social_meta_app_id</source>
                <target>App created on developers.facebook.com, in development mode: it needs neither review nor verification as long as you alone use it.</target>
            </trans-unit>
            <trans-unit id="yUDu_eU">
                <source>description.social_meta_app_secret</source>
                <target>The app's Settings &gt; Basic, on developers.facebook.com.</target>
            </trans-unit>
            <trans-unit id="L9TwCh5">
                <source>description.social_meta_instagram_id</source>
                <target>Filled by "Connect Meta": the Instagram professional account linked to the Page.</target>
            </trans-unit>
            <trans-unit id="u6Xslj2">
                <source>description.social_meta_page_id</source>
                <target>Filled by "Connect Meta": the Page the posts go out on. Entered beforehand, it is kept: useful when the account manages several Pages.</target>
            </trans-unit>
            <trans-unit id="_0D94rb">
                <source>description.social_meta_page_token</source>
                <target>Filled by "Connect Meta". It does not expire, unless the password changes or the app is removed.</target>
            </trans-unit>
            <trans-unit id="KPbdz0r">
                <source>description.social_publish_template</source>
                <target>Template of the posted text. Variables: {title}, {url}, and the content's own ({category}, {description}...). A variable with no value is removed.</target>
            </trans-unit>
            <trans-unit id="CNtk6sR">
                <source>description.social_series_ending_days</source>
                <target>Days before a series' last post when an email is sent to "email-to" to prolong it. 0 sends nothing.</target>
            </trans-unit>
            <trans-unit id="cqh6P23">
                <source>label.social_ai_guidelines</source>
                <target>Tone of the posts (AI)</target>
            </trans-unit>
            <trans-unit id="EXIzXnl">
                <source>label.social_bluesky_handle</source>
                <target>Bluesky handle</target>
            </trans-unit>
            <trans-unit id="lyX1njK">
                <source>label.social_bluesky_oauth_key</source>
                <target>Bluesky client key</target>
            </trans-unit>
            <trans-unit id="2MtcXuy">
                <source>label.social_bluesky_oauth_session</source>
                <target>Bluesky session</target>
            </trans-unit>
            <trans-unit id="cQjSQul">
                <source>label.social_calendar_hour_end</source>
                <target>Calendar: last hour</target>
            </trans-unit>
            <trans-unit id="ijmz2OX">
                <source>label.social_calendar_hour_start</source>
                <target>Calendar: first hour</target>
            </trans-unit>
            <trans-unit id="zo6BSQn">
                <source>label.social_calendar_ics_token</source>
                <target>Calendar: iCal subscription key</target>
            </trans-unit>
            <trans-unit id="Dfr17Uy">
                <source>label.social_enable_share_buttons</source>
                <target>Enable share buttons</target>
            </trans-unit>
            <trans-unit id="9BLGp.J">
                <source>label.social_google_business_account_id</source>
                <target>Google Business Profile account</target>
            </trans-unit>
            <trans-unit id="yO2l7Ek">
                <source>label.social_google_business_location_id</source>
                <target>Google business listing</target>
            </trans-unit>
            <trans-unit id="g3YkJT5">
                <source>label.social_google_listing_url</source>
                <target>Google listing link</target>
            </trans-unit>
            <trans-unit id="hZffD1Y">
                <source>label.social_google_oauth_client_id</source>
                <target>Google OAuth client id (reviews)</target>
            </trans-unit>
            <trans-unit id="iJJMfbS">
                <source>label.social_google_oauth_client_secret</source>
                <target>Google OAuth client secret (reviews)</target>
            </trans-unit>
            <trans-unit id="sWcVVas">
                <source>label.social_google_oauth_refresh_token</source>
                <target>Google refresh token (reviews)</target>
            </trans-unit>
            <trans-unit id="NHvPdOc">
                <source>label.social_image_format</source>
                <target>Visual format</target>
            </trans-unit>
            <trans-unit id="MIY6APF">
                <source>label.social_linkedin_access_token</source>
                <target>LinkedIn token</target>
            </trans-unit>
            <trans-unit id="NNCAytt">
                <source>label.social_linkedin_client_id</source>
                <target>LinkedIn app client ID</target>
            </trans-unit>
            <trans-unit id="zzm_PBk">
                <source>label.social_linkedin_client_secret</source>
                <target>LinkedIn app client secret</target>
            </trans-unit>
            <trans-unit id="W6z9srG">
                <source>label.social_linkedin_member_id</source>
                <target>LinkedIn member</target>
            </trans-unit>
            <trans-unit id="VNIF16G">
                <source>label.social_linkedin_token_expires_at</source>
                <target>LinkedIn token expiry</target>
            </trans-unit>
            <trans-unit id="Ijbvg0M">
                <source>label.social_media_retention_days</source>
                <target>Retention of the posts' medias (days)</target>
            </trans-unit>
            <trans-unit id="5EmIqzw">
                <source>label.social_meta_app_id</source>
                <target>Meta app id</target>
            </trans-unit>
            <trans-unit id="tU2YyQe">
                <source>label.social_meta_app_secret</source>
                <target>Meta app secret</target>
            </trans-unit>
            <trans-unit id="88Fds2N">
                <source>label.social_meta_instagram_id</source>
                <target>Instagram account</target>
            </trans-unit>
            <trans-unit id="mfEfNnJ">
                <source>label.social_meta_page_id</source>
                <target>Facebook Page</target>
            </trans-unit>
            <trans-unit id="q7doyNI">
                <source>label.social_meta_page_token</source>
                <target>Facebook Page token</target>
            </trans-unit>
            <trans-unit id="XYTOV4b">
                <source>label.social_publish_template</source>
                <target>Post text</target>
            </trans-unit>
            <trans-unit id="icVmnRG">
                <source>label.social_series_ending_days</source>
                <target>Series ending: warn (days before)</target>
            </trans-unit>
        </body>
