<?xml version="1.0"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="en" datatype="plaintext" original="site_config.en.xlf">
        <body>
            <trans-unit id="iS6Wrju">
                <source>description.social_bluesky_app_password</source>
                <target>Created in Bluesky, Settings &gt; Privacy and security &gt; App passwords. Never the account's own password.</target>
            </trans-unit>
            <trans-unit id="kmlwOk1">
                <source>description.social_bluesky_handle</source>
                <target>Handle of the account to post on, for instance example.bsky.social.</target>
            </trans-unit>
            <trans-unit id="mgDQlK8">
                <source>description.social_bluesky_publish_mode</source>
                <target>review: each post waits for your review in "Posts". auto: it goes out as soon as it is prepared.</target>
            </trans-unit>
            <trans-unit id="qi3JaGX">
                <source>description.social_enable_share_buttons</source>
                <target>Automatically displays the share buttons on every page (settings under "Share buttons").</target>
            </trans-unit>
            <trans-unit id="UHhe1S3">
                <source>description.social_facebook_publish_mode</source>
                <target>review: each post waits for your review in "Posts". auto: it goes out as soon as it is prepared.</target>
            </trans-unit>
            <trans-unit id="TELuAM2">
                <source>description.social_google_business_account_id</source>
                <target>Google Business Profile account holding the listing, picked after connecting.</target>
            </trans-unit>
            <trans-unit id="E7lJkTq">
                <source>description.social_google_business_location_id</source>
                <target>Business listing whose reviews are imported, picked after connecting.</target>
            </trans-unit>
            <trans-unit id="R3dEfsB">
                <source>description.social_google_listing_url</source>
                <target>Public address of the listing, e.g. https://www.google.com/maps?cid=... : published as sameAs on the contact block, it ties the site and the listing into one business.</target>
            </trans-unit>
            <trans-unit id="3Uz1NWR">
                <source>description.social_google_oauth_client_id</source>
                <target>OAuth client id created in the Google Cloud console.</target>
            </trans-unit>
            <trans-unit id="pgmScSU">
                <source>description.social_google_oauth_client_secret</source>
                <target>OAuth client secret paired with the id above.</target>
            </trans-unit>
            <trans-unit id="5Phnt3P">
                <source>description.social_google_oauth_refresh_token</source>
                <target>Token obtained when connecting to Google; replacing it stops the review import.</target>
            </trans-unit>
            <trans-unit id="61_ZokG">
                <source>description.social_instagram_publish_mode</source>
                <target>review: each post waits for your review in "Posts". auto: it goes out as soon as it is prepared.</target>
            </trans-unit>
            <trans-unit id="vdijy68">
                <source>description.social_meta_app_id</source>
                <target>App created on developers.facebook.com, in development mode: it needs neither review nor verification as long as you alone use it.</target>
            </trans-unit>
            <trans-unit id="yUDu_eU">
                <source>description.social_meta_app_secret</source>
                <target>The app's Settings &gt; Basic, on developers.facebook.com.</target>
            </trans-unit>
            <trans-unit id="L9TwCh5">
                <source>description.social_meta_instagram_id</source>
                <target>Filled by "Connect Meta": the Instagram professional account linked to the Page.</target>
            </trans-unit>
            <trans-unit id="u6Xslj2">
                <source>description.social_meta_page_id</source>
                <target>Filled by "Connect Meta": the Page the posts go out on. Entered beforehand, it is kept: useful when the account manages several Pages.</target>
            </trans-unit>
            <trans-unit id="_0D94rb">
                <source>description.social_meta_page_token</source>
                <target>Filled by "Connect Meta". It does not expire, unless the password changes or the app is removed.</target>
            </trans-unit>
            <trans-unit id="5.iDFNb">
                <source>description.social_publish_enabled</source>
                <target>Posts one content (a gallery photo for instance) on every configured network, at the interval below. A content is never posted twice.</target>
            </trans-unit>
            <trans-unit id="93yR.lo">
                <source>description.social_publish_interval_hours</source>
                <target>Minimum time between two automatic posts: 24 for one a day, 168 for one a week.</target>
            </trans-unit>
            <trans-unit id="KPbdz0r">
                <source>description.social_publish_template</source>
                <target>Template of the posted text. Variables: {title}, {url}, and the content's own ({category}, {description}...). A variable with no value is removed.</target>
            </trans-unit>
            <trans-unit id="ZuIuKpS">
                <source>label.social_bluesky_app_password</source>
                <target>Bluesky app password</target>
            </trans-unit>
            <trans-unit id="EXIzXnl">
                <source>label.social_bluesky_handle</source>
                <target>Bluesky handle</target>
            </trans-unit>
            <trans-unit id="mOorxO_">
                <source>label.social_bluesky_publish_mode</source>
                <target>Posting on Bluesky</target>
            </trans-unit>
            <trans-unit id="Dfr17Uy">
                <source>label.social_enable_share_buttons</source>
                <target>Enable share buttons</target>
            </trans-unit>
